{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "description": "shadcn/ui组件库MCP服务器"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "env": {
        "CHROME_EXECUTABLE": "/usr/bin/chromium-browser",
        "CHROME_ARGS": "--no-sandbox --headless --disable-gpu --disable-dev-shm-usage"
      },
      "description": "Chrome DevTools MCP服务器"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "description": "Sequential Thinking MCP服务器"
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "env": {
        "NEXT_PUBLIC_PROJECT_ROOT": "${PROJECT_ROOT}"
      },
      "description": "Next.js开发工具MCP服务器"
    },
    "openapi-docs": {
      "command": "npx",
      "args": [
        "-y",
        "apifox-mcp-server@latest",
        "--oas=openapi.json"
      ],
      "description": "OpenAPI文档服务器"
    },
    "svar-mcp": {
      "type": "http",
      "url": "https://docs.svar.dev/mcp",
      "description": "Svar MCP服务器"
    }
  }
}