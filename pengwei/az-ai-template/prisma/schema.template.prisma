// Prisma Schema Template for MongoDB
// 深瞳AI Coding 数据库模型模板
//
// 📝 使用说明：
// 1. 此文件是模板文件，请勿直接修改 prisma/schema.prisma
// 2. 添加新表时，只需在此文件中定义模型
// 3. 运行 `npm run generate:schema` 自动生成带前缀的 schema
// 4. 运行 `npm run db:migrate:prefix` 自动迁移数据库表名
//
// 🎯 表名规则：
// - 模板中的 @@map("table_name") 会被自动替换为 @@map("{PROJECT_TABLE_PREFIX}-table_name")
// - 例如：项目名为 test1，则 @@map("users") → @@map("test1-users")
// - 前缀由项目目录名决定（运行 node scripts/sync-project-prefix.js 自动配置）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// 登录用户模型（从 login.json 迁移）
// ============================================
model LoginUser {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  username    String   @unique
  password    String
  displayName String
  email       String   @unique
  avatar      String   @default("")
  status      String   @default("active") // active, inactive, suspended
  department  String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("login_users")
}

// ============================================
// 用户模型（从 users.json 迁移）
// ============================================
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  nickname  String
  avatar    String   @default("")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

