{
  "name": "az-ai-template",
  "version": "0.1.0",
  "private": true,
  "description": "深瞳AI Coding - 智能AI编码助手平台",
  "scripts": {
    "dev": "rm -rf .next && next dev --turbopack",
    "dev:3000": "bash scripts/dev-3000.sh",
    "build": "node scripts/generate-schema.js && prisma generate && next build --turbo",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:component-skills": "bash .claude/skills/component-library-guide/scripts/verify-component-skills.sh",
    "audit:component-skills": "bash .claude/skills/component-library-guide/scripts/verify-component-skills.sh --verbose",
    "workflow:timestamp": "python3 .claude/skills/workflow-manager/scripts/timestamp_workflow.py",
    "workflow:analyze": "python3 .claude/skills/workflow-manager/scripts/analyze_workflow_time.py",
    "openapi:generate": "tsx scripts/generate-openapi-with-doc.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "tsx scripts/migrate-json-to-mongodb.ts",
    "generate:schema": "node scripts/generate-schema.js && prisma generate",
    "db:migrate:prefix": "node scripts/migrate-table-prefix.js",
    "prepare": "husky",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "verify:e2e": "bash ./.scripts/verify-e2e-executed.sh",
    "validate-routes": "node scripts/validate-routes.js",
    "smoke-test": "playwright test tests/smoke/",
    "qa-check": "bash scripts/qa-check.sh",
    "fix-e2e-environment": "bash scripts/fix-e2e-environment.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
