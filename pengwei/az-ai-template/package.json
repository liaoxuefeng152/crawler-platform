    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@tiptap/y-tiptap": "^3.0.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "jose": "^6.1.3",
    "lucide-react": "^0.561.0",
    "mongodb": "^7.1.0",
    "next": "16.0.10",
    "next-swagger-doc": "^0.4.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
